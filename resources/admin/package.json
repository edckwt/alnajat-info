{
  "private": true,
  "description": "بناء CSS لوحة التحكم (قالب روبيك، Tailwind 3). منفصل عن package.json الرئيسي لأن Laravel 13 يستخدم Tailwind 4.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i css/app.css -o ../../public/admin/css/app.css --minify",
    "dev": "tailwindcss -c tailwind.config.js -i css/app.css -o ../../public/admin/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
